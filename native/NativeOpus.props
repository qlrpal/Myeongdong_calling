<Project>
  <!-- Executables own native assets; do not import this into the SDK source project. -->
  <ItemGroup>
    <PackageReference Include="Concentus.Native" Version="1.5.2" />
    <PackageReference Include="Concentus.Native.NetCore" Version="1.5.2" GeneratePathProperty="true" />
    <Content Include="$(PkgConcentus_Native_NetCore)/LICENSE" Link="Opus.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
