<Project>
  <PropertyGroup>
    <!-- This latency experiment compiles optimized code on first use instead of tiering during audio. -->
    <TieredCompilation>false</TieredCompilation>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- WinForms + COM/PInvoke only: no Windows Runtime projections are used. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
  </PropertyGroup>
</Project>
